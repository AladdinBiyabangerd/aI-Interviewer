AI_INTERVIEWER_ENVIRONMENT=development
# Staging/production require a non-default release label and full 40-character source SHA.
AI_INTERVIEWER_RELEASE_ID=development
AI_INTERVIEWER_RELEASE_REVISION=unknown
AI_INTERVIEWER_LOG_LEVEL=INFO
AI_INTERVIEWER_DOCS_ENABLED=true
# Staging/production require OTLP telemetry. Use an HTTPS collector or a loopback sidecar.
AI_INTERVIEWER_TELEMETRY_ENABLED=false
# AI_INTERVIEWER_TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4318
AI_INTERVIEWER_TELEMETRY_TRACE_SAMPLE_RATIO=0.1
AI_INTERVIEWER_TELEMETRY_EXPORT_INTERVAL_SECONDS=30
AI_INTERVIEWER_TELEMETRY_EXPORT_TIMEOUT_SECONDS=5
AI_INTERVIEWER_TELEMETRY_SPAN_SCHEDULE_DELAY_MS=5000
AI_INTERVIEWER_TELEMETRY_SPAN_QUEUE_SIZE=2048
AI_INTERVIEWER_TELEMETRY_SPAN_BATCH_SIZE=512
AI_INTERVIEWER_TELEMETRY_MONITOR_INTERVAL_SECONDS=30
AI_INTERVIEWER_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
AI_INTERVIEWER_DATABASE_URL=postgresql+psycopg://ai_interviewer:local-only@127.0.0.1:55432/ai_interviewer
# Staging/production must use an absolute orchestrator-mounted secret file instead of DATABASE_URL.
# AI_INTERVIEWER_DATABASE_URL_FILE=/run/secrets/ai-interviewer-database-url
AI_INTERVIEWER_DATABASE_TLS_MODE=disable
AI_INTERVIEWER_DATABASE_POOL_SIZE=5
AI_INTERVIEWER_DATABASE_MAX_OVERFLOW=5
AI_INTERVIEWER_DATABASE_POOL_TIMEOUT_SECONDS=5
AI_INTERVIEWER_DATABASE_POOL_RECYCLE_SECONDS=1800
AI_INTERVIEWER_DATABASE_CONNECT_TIMEOUT_SECONDS=5
AI_INTERVIEWER_DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=2
AI_INTERVIEWER_DATABASE_STATEMENT_TIMEOUT_MS=30000
# Used only by the one-off `ai-interviewer-migrate upgrade` release job.
AI_INTERVIEWER_MIGRATION_LOCK_TIMEOUT_SECONDS=60
AI_INTERVIEWER_MIGRATION_LOCK_POLL_SECONDS=0.25
AI_INTERVIEWER_AUTH_ENABLED=false
# Required together when authentication is enabled. Hosted URLs must use HTTPS.
# AI_INTERVIEWER_AUTH_OIDC_ISSUER=https://identity.example.com/
# AI_INTERVIEWER_AUTH_OIDC_AUDIENCE=https://api.example.com
# AI_INTERVIEWER_AUTH_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AI_INTERVIEWER_AUTH_OIDC_ALGORITHMS=["RS256"]
AI_INTERVIEWER_AUTH_REQUIRED_TOKEN_TYPE=at+jwt
AI_INTERVIEWER_AUTH_CLOCK_SKEW_SECONDS=30
AI_INTERVIEWER_AUTH_MAX_TOKEN_AGE_SECONDS=3600
AI_INTERVIEWER_AUTH_MAX_TOKEN_LENGTH=8192
AI_INTERVIEWER_AUTH_JWKS_TIMEOUT_SECONDS=3
AI_INTERVIEWER_AUTH_JWKS_CACHE_SECONDS=300
AI_INTERVIEWER_PRIVACY_ENABLED=false
# Development-only legacy value. Staging/production must use PRIVACY_KEYRING_FILE.
# AI_INTERVIEWER_PRIVACY_SUBJECT_HMAC_KEY=replace-with-a-secret-manager-value
# JSON keyring version 1 with distinct subject_hmac, field_encryption, and manifest_hmac keys.
# AI_INTERVIEWER_PRIVACY_KEYRING_FILE=/run/secrets/ai-interviewer-privacy-keyring
AI_INTERVIEWER_PRIVACY_MAX_PROCESSOR_DELETION_ATTEMPTS=10
AI_INTERVIEWER_PRIVACY_PROCESSOR_RETRY_BASE_SECONDS=60
AI_INTERVIEWER_FILE_SECURITY_ENABLED=false
# Required when file security is enabled. Use workload identity for AWS credentials.
# AI_INTERVIEWER_OBJECT_STORAGE_BUCKET=private-interview-files
# AI_INTERVIEWER_OBJECT_STORAGE_REGION=eu-central-1
# AI_INTERVIEWER_OBJECT_STORAGE_KMS_KEY_ID=alias/ai-interviewer-files
# Optional for a reviewed S3-compatible service; hosted environments require HTTPS.
# AI_INTERVIEWER_OBJECT_STORAGE_ENDPOINT_URL=https://s3.example.com
AI_INTERVIEWER_OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=3
AI_INTERVIEWER_OBJECT_STORAGE_READ_TIMEOUT_SECONDS=10
AI_INTERVIEWER_FILE_SECURITY_MAX_UPLOAD_BYTES=10485760
AI_INTERVIEWER_FILE_SECURITY_MAX_ARCHIVE_ENTRIES=2000
AI_INTERVIEWER_FILE_SECURITY_MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
# Hosted scanning requires an absolute local Unix socket to an isolated clamd sidecar.
# AI_INTERVIEWER_MALWARE_SCANNER_UNIX_SOCKET=/run/clamav/clamd.sock
# Development-only alternative:
# AI_INTERVIEWER_MALWARE_SCANNER_TCP_HOST=127.0.0.1
AI_INTERVIEWER_MALWARE_SCANNER_TCP_PORT=3310
AI_INTERVIEWER_MALWARE_SCANNER_TIMEOUT_SECONDS=15
AI_INTERVIEWER_MALWARE_SCANNER_MAX_SIGNATURE_AGE_HOURS=48
