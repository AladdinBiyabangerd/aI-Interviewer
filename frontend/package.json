{
  "name": "interview-ai-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "bank": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/question-bank.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "admin:rotate": "node scripts/setup-admin.mjs --rotate",
    "test:assessment:http": "node --experimental-strip-types scripts/assessment-http.integration.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.0",
    "next": "^16.3.4",
    "openai": "^7.9.0",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
