# Public canonical URL (no trailing slash). Set to the Vercel or Railway web domain.
NEXT_PUBLIC_APP_URL=https://interview-prep.example.com

# Server-only managed PostgreSQL connection string (Vercel Marketplace, Railway, Neon, …).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Provider-supplied direct connection for the one-off migration job; the Next runtime does not read it.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Server-only token automatically injected when a PRIVATE Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Server-only OpenAI project key and reviewed Responses API model.
OPENAI_API_KEY=replace_with_a_new_server_side_project_key
OPENAI_INTERVIEW_MODEL=gpt-5.5

# Server-only signing key. Generate at least 32 random bytes; never prefix it with NEXT_PUBLIC_.
INTERVIEW_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Server-only webhook secret from the OpenAI project webhook configuration.
OPENAI_WEBHOOK_SECRET=whsec_replace_me

# Server-only secret used by Vercel Cron (or an external scheduler on Railway) as the Authorization bearer token.
CRON_SECRET=replace_with_at_least_32_random_bytes

# Standalone admin login at /admin/login. Generate locally with npm run admin:setup.
# Set the generated username and password hash as server-only deployment variables.
INTERVIEW_ADMIN_USERNAME=admin
INTERVIEW_ADMIN_PASSWORD_HASH=replace_with_generated_scrypt_hash

# Portal OIDC SSO. All values are server-only; do not add NEXT_PUBLIC_ variants.
PORTAL_OIDC_ENABLED=false
PORTAL_OIDC_ISSUER=https://ingress.academy/
PORTAL_OIDC_CLIENT_ID=interview-web
PORTAL_OIDC_REDIRECT_URI=https://interview.ingress.academy/api/auth/callback
PORTAL_OIDC_JWKS_URL=https://ingress.academy/portal/oauth/jwks.json
INTERVIEW_API_BASE_URL=https://api.interview.ingress.academy
PORTAL_HOME_URL=https://ingress.academy/portal/welcome/

# Optional bounded product controls.
INTERVIEW_RETENTION_DAYS=7
INTERVIEW_ANALYSIS_LIMIT_PER_10_MINUTES=5
