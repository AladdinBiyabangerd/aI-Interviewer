# Public canonical URL. Set this to the production Vercel domain (no trailing slash).
NEXT_PUBLIC_APP_URL=https://interview-prep.example.com

# Server-only managed PostgreSQL connection string. A Vercel Marketplace database can inject it.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Provider-supplied direct connection for the one-off migration job; the Next runtime does not read it.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Server-only token automatically injected when a PRIVATE Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Server-only OpenAI project key and reviewed Responses API model.
OPENAI_API_KEY=replace_with_a_new_server_side_project_key
OPENAI_INTERVIEW_MODEL=gpt-5.5

# Server-only signing key. Generate at least 32 random bytes; never prefix it with NEXT_PUBLIC_.
INTERVIEW_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Server-only webhook secret from the OpenAI project webhook configuration.
OPENAI_WEBHOOK_SECRET=whsec_replace_me

# Server-only secret used by Vercel Cron as the Authorization bearer token.
CRON_SECRET=replace_with_at_least_32_random_bytes

# Optional bounded product controls.
INTERVIEW_RETENTION_DAYS=7
INTERVIEW_ANALYSIS_LIMIT_PER_10_MINUTES=5
