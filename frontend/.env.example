# Server-only OpenAI configuration for live company research.
# Never expose this value through a NEXT_PUBLIC_ variable.
# OPENAI_API_KEY=replace-with-a-new-private-key
OPENAI_INTERVIEW_MODEL=gpt-5.5

# Optional external backend origin. Leave unset to use the same-origin research route.
# NEXT_PUBLIC_INTERVIEW_API_BASE_URL=https://api.example.com
